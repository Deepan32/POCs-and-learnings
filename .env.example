# ALLSTREAK Environment Configuration

APP_NAME=ALLSTREAK
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL in production, SQLite automatic for zero-config local run)
DATABASE_URL=sqlite+aiosqlite:///./allstreak.db
# DATABASE_URL=postgresql+asyncpg://allstreak_user:password@localhost:5432/allstreak

# Redis (Optional in local dev, in-memory fallback active)
REDIS_URL=redis://localhost:6379/0
USE_REDIS=false

# Authentication Secrets
JWT_SECRET=allstreak-super-secret-production-jwt-key-change-in-prod-2026
JWT_REFRESH_SECRET=allstreak-super-secret-refresh-key-change-in-prod-2026

# Meta WhatsApp Cloud API (Graph API v21.0)
META_GRAPH_URL=https://graph.facebook.com
META_API_VERSION=v21.0
META_ACCESS_TOKEN=your_permanent_system_user_token
META_VERIFY_TOKEN=allstreak_secure_verify_token_2026
META_APP_SECRET=your_meta_app_secret
META_PHONE_NUMBER_ID=your_phone_number_id
META_WABA_ID=your_waba_id
META_BUSINESS_ID=your_business_id

# Customer Service Window (Hours)
WHATSAPP_WINDOW_HOURS=24

# AI Agent & Semantic RAG (Optional OpenAI integration)
OPENAI_API_KEY=
AI_DEFAULT_MODEL=gpt-4o-mini

# URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
